# Database
DATABASE_URL=your_database_url

# Comma-separated frontend origins allowed to call this API.
# Local dev default is http://localhost:3000; in production set your Vercel URL.
CORS_ORIGINS=http://localhost:3000

# AWS Bedrock
AWS_BEARER_TOKEN_BEDROCK=your_aws_bearer_token
AWS_REGION=your_aws_region
MODEL_ID=your_bedrock_model_id

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS Knowledge Base
KNOWLEDGE_BASE_ID=your_knowledge_base_id
KNOWLEDGE_BASE_MODEL_ARN=your_knowledge_base_model_arn